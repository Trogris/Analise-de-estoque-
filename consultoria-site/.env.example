# URL pública do site (usada em SEO, sitemap e Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Destino das mensagens do formulário de contato.
# Qualquer endpoint que aceite POST JSON: Zapier, Make, Formspree, n8n, CRM etc.
