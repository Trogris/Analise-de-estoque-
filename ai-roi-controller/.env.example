# Copie para .env.local (desenvolvimento) ou cadastre como variáveis de ambiente na Vercel.
# Sem estas variáveis a aplicação funciona em MODO LOCAL: os dados ficam só no navegador.

# ID da planilha: o trecho da URL entre /d/ e /edit
GOOGLE_SHEETS_ID=

# Conta de serviço do Google Cloud com a API do Google Sheets ativada.
# Compartilhe a planilha com este e-mail, como Editor.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Chave privada do JSON da conta de serviço (campo "private_key"), em uma linha, com \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Senha única de acesso da equipe. Obrigatória em produção quando a planilha está conectada.
APP_PASSWORD=
